# ============ 数据库（docker-compose 默认口径） ============
DATABASE_URL=postgres://postgres:workloom@localhost:5432/workloom
# 应用双角色（A3：旁路直写防控——只有 gateway 角色可 INSERT biz_events）
APP_DB_PASSWORD=workloom_dev_app
GATEWAY_DB_PASSWORD=workloom_dev_gateway
DATABASE_APP_URL=postgres://workloom_app:workloom_dev_app@localhost:5432/workloom
DATABASE_GATEWAY_URL=postgres://workloom_gateway:workloom_dev_gateway@localhost:5432/workloom

# ============ LLM（可选；默认 mock，离线可跑通全流程） ============
# mock | deepseek | moonshot | zhipu | openai
LLM_PROVIDER=mock
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# ============ IM 通道（B11/D14；默认 mock，无凭据全流程可跑——与 LLM 同纪律） ============
# mock | dsh-im（真实通道凭据在 dsh 设置页配置：bash scripts/install-im-channels.sh 后 dsh web → IM机器人）
IM_DRIVER=mock

# ============ 演示身份 JWT（B5；生产必须更换） ============
JWT_SECRET=hyperreality-dev-secret-change-me

# ============ 服务端口 ============
SERVER_PORT=8787
WEB_PORT=5173

# ============ 视频经理 · 视频制作（vendor/supermickey 引擎） ============
# 渲染（火山引擎方舟；缺省时 render.submit 走 mock 并明确标注）
VOLCENGINE_ARK_API_KEY=
SEEDANCE_ENDPOINT=
SEEDREAM_ENDPOINT=
# 预生产工作目录（checkpoints/characters/confirmations 等运行产物根）
HR_WORK_DIR=.vm-work
# 审批轮询（studio-worker）
HR_APPROVAL_POLL_MS=2000
HR_APPROVAL_TIMEOUT_MS=7200000

# ============ WorkLoom GEO · 双域融合经营（bundles/geo-growth） ============
# AI 能见度监测通道（五级分层 L1 官方 API→L3 RPA 剧本→L5 人工；缺省 mock，离线可跑通）
# 监测平台：豆包/DeepSeek/元宝/ChatGPT 四平台先行，出海客户扩展 Perplexity
VISIBILITY_PLATFORMS=doubao,deepseek,yuanbao,chatgpt
VISIBILITY_DRIVER=mock
# 采集节奏：品牌词日频 + 全量 query 集周频（cron 口径）
VISIBILITY_BRAND_CRON=0 21 * * *
VISIBILITY_FULL_CRON=0 9 * * 1
# 信源分发渠道（知乎/头条号/百家号/公众号/新闻稿/垂媒/百科；publish-rpa 扩适配器）
SOURCE_CHANNELS=zhihu,toutiao,baijiahao,gongzhonghao
SOURCE_DRIVER=mock
# 数据边界红线：客户业务数据（客资/WhatsApp 聊天/线索）留客户系统，事件链只记经营动作留痕
DATA_BOUNDARY_STRICT=true

# ============ AI 服务前台（C 端，ToBToC） ============
# C 端会话与工单挂载的工作区（缺省取首个工作区；GEO 双域部署建议显式指定）
SERVICE_C_WORKSPACE_ID=
# h5 演示直登开关（生产置 false 后仅 code 换 openid）
SERVICE_C_DEMO_AUTH=true
# C 端令牌密钥（生产必填，>=32 字符）
SERVICE_C_SECRET=
