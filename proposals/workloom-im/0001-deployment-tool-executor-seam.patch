@@ -0,0 +1,46 @@
+/**
+ * 部署层 ToolExecutor 加载器（T-2026-0919-0011）。
+ *
+ * 基座不认识任何行业连接器：只在部署环境声明 `WORKLOOM_TOOL_EXECUTOR_MODULE`
+ * 指向一个模块（本地路径或 npm 包名），由该模块导出 `createToolExecutor(scope)`
+ * 或 `createToolExecutorForScope(scope)`。未配置时返回 undefined，runQuest 保持
+ * 现有兜底语义（模拟档案 → 本地模拟回执；真实档案 → 未核实）。
+ *
+ * 失败关闭：模块加载失败、缺少工厂、工厂返回非函数都直接抛错，绝不静默降级成
+ * 「模拟成功」——演示与真实能力必须分明。
+ */
+import type { ToolExecutor } from "@workloom/runtime";
+
+export const TOOL_EXECUTOR_MODULE_ENV = "WORKLOOM_TOOL_EXECUTOR_MODULE";
+
+export interface ToolExecutorScope {
+  tenantId: string;
+  workspaceId: string;
+}
+
+export async function loadDeploymentToolExecutor(
+  scope?: ToolExecutorScope,
+): Promise<ToolExecutor | undefined> {
+  const modulePath = process.env[TOOL_EXECUTOR_MODULE_ENV]?.trim();
+  if (!modulePath) return undefined;
+
+  let module: Record<string, unknown>;
+  try {
+    module = (await import(modulePath)) as Record<string, unknown>;
+  } catch (error) {
+    throw new Error(
+      `部署工具执行器加载失败：${modulePath}（${error instanceof Error ? error.message : String(error)}）`,
+    );
+  }
+
+  const factory = module.createToolExecutor ?? module.createToolExecutorForScope;
+  if (typeof factory !== "function") {
+    throw new Error(`部署工具执行器模块未导出 createToolExecutor(scope)：${modulePath}`);
+  }
+  const executor = await (factory as (value?: ToolExecutorScope) => unknown)(scope);
+  if (executor === undefined || executor === null) return undefined;
+  if (typeof executor !== "function") {
+    throw new Error(`部署工具执行器工厂必须返回函数或 undefined：${modulePath}`);
+  }
+  return executor as ToolExecutor;
+}
