+import { describe, expect, it } from "vitest";
+import { runToolSafely, type ToolExecutor } from "./tools.js";
+
+describe("runToolSafely（T-2026-0919-0011）", () => {
+  it("执行器成功时原样透传结果与回执", async () => {
+    const executor: ToolExecutor = async () => ({
+      result: { ok: true },
+      receipt: { synced: true, snapshot_uri: "file:///tmp/a.png", verified_at: "2026-09-19T00:00:00Z" },
+    });
+    const out = await runToolSafely(executor, "visualwrite.compose", { recipe: {} });
+    expect(out.receipt.synced).toBe(true);
+    expect(out.result).toEqual({ ok: true });
+  });
+
+  it("执行器抛异常 → 未核实结果，不冒泡", async () => {
+    const executor: ToolExecutor = async () => {
+      throw new Error("connect ECONNREFUSED 127.0.0.1:9773");
+    };
+    const out = await runToolSafely(executor, "visualwrite.compose", { recipe: {} });
+    expect(out.receipt).toEqual({ synced: false });
+    expect(out.result).toMatchObject({ state: "tool-error", tool: "visualwrite.compose" });
+    expect(String(out.result.error)).toContain("ECONNREFUSED");
+  });
+
+  it("非 Error 抛出物也收敛为字符串", async () => {
+    const executor: ToolExecutor = async () => {
+      throw "boom";
+    };
+    const out = await runToolSafely(executor, "visualwrite.render", {});
+    expect(out.receipt.synced).toBe(false);
+    expect(out.result.error).toBe("boom");
+  });
+});
