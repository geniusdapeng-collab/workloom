 }
+
+/**
+ * 工具执行安全网（T-2026-0919-0011）：
+ *
+ * 部署层注入的执行器（连接器 / 远程工位）可能因为网络、超时、进程退出而抛异常。
+ * 异常直接冒泡会跳过「执行事件 + 线程进度」的同一事务，把线程留在 running——
+ * 既没有回执也没有失败留痕，断点续跑会一直卡在同一个步骤。
+ *
+ * 这里把异常收敛成「未核实」结果：runQuest 会照常写事件、把步骤加入 unverified，
+ * 最终把线程置为 failed（E3.7：无回执不得宣称完成）。
+ */
+export async function runToolSafely(
+  executor: ToolExecutor,
+  name: string,
+  params: Record<string, unknown>,
+): Promise<ToolResult> {
+  try {
+    return await executor(name, params);
+  } catch (error) {
+    return {
+      result: {
+        state: "tool-error",
+        tool: name,
+        error: error instanceof Error ? error.message : String(error),
+      },
+      receipt: { synced: false },
+    };
+  }
+}
