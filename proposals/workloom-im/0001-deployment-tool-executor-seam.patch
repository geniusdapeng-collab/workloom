+import { mkdtempSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { afterEach, describe, expect, it } from "vitest";
+import { loadDeploymentToolExecutor, TOOL_EXECUTOR_MODULE_ENV } from "./tool-executor.js";
+
+const original = process.env[TOOL_EXECUTOR_MODULE_ENV];
+
+afterEach(() => {
+  if (original === undefined) delete process.env[TOOL_EXECUTOR_MODULE_ENV];
+  else process.env[TOOL_EXECUTOR_MODULE_ENV] = original;
+});
+
+function moduleFile(source: string): string {
+  const directory = mkdtempSync(join(tmpdir(), "wl-tool-executor-"));
+  const path = join(directory, "executor.mjs");
+  writeFileSync(path, source);
+  return pathToFileURL(path).href;
+}
+
+describe("loadDeploymentToolExecutor（T-2026-0919-0011）", () => {
+  it("未配置 env → undefined（保持兜底执行器语义）", async () => {
+    delete process.env[TOOL_EXECUTOR_MODULE_ENV];
+    expect(await loadDeploymentToolExecutor()).toBeUndefined();
+  });
+
+  it("模块导出 createToolExecutor 时按作用域构建并返回函数", async () => {
+    process.env[TOOL_EXECUTOR_MODULE_ENV] = moduleFile(`
+      export function createToolExecutor(scope) {
+        return async (name, params) => ({
+          result: { name, params, workspace: scope?.workspaceId },
+          receipt: { synced: true, verified_at: "2026-09-19T00:00:00Z" },
+        });
+      }
+    `);
+    const executor = await loadDeploymentToolExecutor({ tenantId: "tenant-demo", workspaceId: "ws-geo" });
+    expect(typeof executor).toBe("function");
+    const out = await executor!("visualwrite.compose", { recipe: "r" });
+    expect(out.receipt.synced).toBe(true);
+    expect(out.result.workspace).toBe("ws-geo");
+  });
+
+  it("工厂返回 undefined → 视作未配置", async () => {
+    process.env[TOOL_EXECUTOR_MODULE_ENV] = moduleFile(`export function createToolExecutor() { return undefined; }`);
+    expect(await loadDeploymentToolExecutor()).toBeUndefined();
+  });
+
+  it("缺少工厂 → fail-closed 抛错", async () => {
+    process.env[TOOL_EXECUTOR_MODULE_ENV] = moduleFile(`export const nope = 1;`);
+    await expect(loadDeploymentToolExecutor()).rejects.toThrow(/未导出 createToolExecutor/);
+  });
+
+  it("工厂返回非函数 → fail-closed 抛错", async () => {
+    process.env[TOOL_EXECUTOR_MODULE_ENV] = moduleFile(`export function createToolExecutor() { return 42; }`);
+    await expect(loadDeploymentToolExecutor()).rejects.toThrow(/必须返回函数/);
+  });
+
+  it("模块加载失败 → fail-closed 抛错", async () => {
+    process.env[TOOL_EXECUTOR_MODULE_ENV] = pathToFileURL(join(tmpdir(), "definitely-missing-executor.mjs")).href;
+    await expect(loadDeploymentToolExecutor()).rejects.toThrow(/加载失败/);
+  });
+});
